<?php

namespace Tests\Feature;

use Illuminate\Contracts\Auth\Authenticatable;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Laravel\Sanctum\Sanctum;
use Ssdev\ApiContracts\Testing\InteractsWithApiContract;
use Ssdev\Headless\Account\AdminAccess;
use Ssdev\Headless\Permissions\PermissionSynchronizer;
use Tests\TestCase;

/**
 * Snapshots of the ssdev/laravel-headless roles API as this application serves it.
 * After an intentional change: API_CONTRACT_UPDATE=1 php artisan test tests/Feature/HeadlessRolesApiContractTest.php
 */
class HeadlessRolesApiContractTest extends TestCase
{
    use InteractsWithApiContract;
    use RefreshDatabase;

    public function test_roles_list_matches_contract(): void
    {
        Sanctum::actingAs($this->createAdmin(), ['*']);

        $response = $this->getJson($this->url('roles'));

        $response->assertOk();
        $this->assertMatchesApiContract('headless_roles_GET_roles', $response->json());
    }

    public function test_permissions_list_matches_contract(): void
    {
        Sanctum::actingAs($this->createAdmin(), ['*']);

        $response = $this->getJson($this->url('permissions'));

        $response->assertOk();
        $this->assertMatchesApiContract('headless_roles_GET_permissions', $response->json());
    }

    private function createAdmin(): Authenticatable
    {
        $model = config('auth.providers.users.model');
        $admin = $model::factory()->create();

        app(PermissionSynchronizer::class)->sync();
        app(AdminAccess::class)->grant($admin);

        return $admin;
    }

    private function url(string $path): string
    {
        return '/'.trim(config('headless.api.prefix'), '/').'/'.$path;
    }
}
